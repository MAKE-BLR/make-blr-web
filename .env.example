# Explicit launch switch. Turn on only after the launch checklist is complete.
WAITLIST_ENABLED=false

# Use the Supabase project URL and server-side service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email acknowledgements require a verified sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="MAKE-BLR <hello@make-blr.com>"

# Optional but strongly recommended on the public internet:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public URL for footer and mail links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Before opening public signups, fill in ALL fields above.
# The page shows 'SIGNUPS OPENING SOON' until configured AND explicitly enabled.
